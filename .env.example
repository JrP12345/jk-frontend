# Ekavyu Frontend Environment Variables
# Development only. In Vercel's Production environment, set this to the actual
# HTTPS backend API URL (including /api), then redeploy to rebuild browser code.
# Example shape: https://your-backend.onrender.com/api (replace the hostname).
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional raster-map provider for Browse Map view. Compiled into browser code.
# Default: https://tile.openstreetmap.org/{z}/{x}/{y}.png (visible OSM attribution).
# Select a provider appropriate for expected traffic and retain its required credit.
# NEXT_PUBLIC_MAP_TILE_URL=https://your-tile-provider.example/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_CREDIT=Your map provider

# Set the confirmed frontend origin in production for canonical URLs, social
# previews and sitemap.xml. Provider pages stay noindex without this setting.
# Use an origin without a path, query, credentials or fragment, not the API URL.
# Supply APP_URL at build and runtime; static metadata/robots use the build value.
# APP_URL=https://your-frontend.example

# Cloudflare Workers (alternative to the local values above):
# NEXT_PUBLIC_API_URL=https://dev.ekavyu.com/api
# APP_URL=https://dev.ekavyu.com
# BACKEND_INTERNAL_URL=https://YOUR-EXISTING-RENDER-HOST.onrender.com
# NEXT_PUBLIC_WS_URL=wss://dev.ekavyu.com
# Supply these at build time. BACKEND_INTERNAL_URL is also emitted as a Worker
# text binding. Do not set NEXT_PUBLIC_BACKEND_URL to Render for this target:
# sockets must use the frontend origin so host-only auth cookies accompany them.
# Never put MongoDB credentials or backend signing keys in this repository.
